# Copy to .env and adjust for your machine. Never commit the real .env file.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The existing frontend is served via `npx http-server` on 5500 in local dev.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# Flat delivery fee (PKR) applied to orderType "delivery". Pickup orders are always 0.
DELIVERY_FEE=150

# Rate limiting (public write endpoints: orders, reservations)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# ---------------------------------------------------------------------------
# Phase 2 (database) will add DATABASE_URL and friends here. Nothing in this
# phase reads a database connection string — see backend/API.md.
# ---------------------------------------------------------------------------
