# Copy to .env and adjust for your machine. Never commit the real .env file.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# The existing frontend is served via `npx http-server` on 5500 in local dev.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# Flat delivery fee (PKR) applied to orderType "delivery". Pickup orders are always 0.
DELIVERY_FEE=150

# Rate limiting (public write endpoints: orders, reservations)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Reverse-proxy hops in front of this app (0 = none). REQUIRED in production
# behind a proxy/load balancer, or every visitor shares the proxy's IP for rate limiting.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Database (Phase 2). See DATABASE.md for full local setup instructions.
# Never point this at production from a developer machine.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ---------------------------------------------------------------------------
# Admin dashboard auth. See DEPLOYMENT.md.
# Generate ADMIN_JWT_SECRET with: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_JWT_SECRET=replace-with-a-random-64-character-hex-string

# The dashboard login. YOU choose it; nothing is hardcoded or seeded.
# Normally leave these UNSET: `npm run admin:setup` asks you for the email and
# password in the terminal (password hidden) and stores only a bcrypt hash.
# Set them only for unattended setups (e.g. a host's one-off command); values
# are then used as-is, never printed, and only read by `admin:setup`.
# Password: 12+ characters with a letter and a number.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Customer accounts (public website login). Must differ from ADMIN_JWT_SECRET.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CUSTOMER_JWT_SECRET=replace-with-a-different-random-64-character-hex-string
# How long a customer stays logged in on their device
CUSTOMER_SESSION_DAYS=30
# Signup / login attempts per IP per window (each counted separately)
CUSTOMER_AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Email (order/reservation alerts to the restaurant, status emails to customers).
# Leave SMTP_HOST empty in development: emails are then only logged, not sent.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Production-only escape hatch: boot without SMTP_HOST (emails are logged, never sent).
# Leave unset/false once a mail provider is configured.
# ALLOW_NO_SMTP=true
MAIL_FROM="Grill Out <no-reply@example.com>"
# Where new-order / new-reservation alerts go (defaults to ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=

# The restaurant's timezone (IANA name). "Today" for reservations and the dashboard uses it.
RESTAURANT_TIMEZONE=Asia/Karachi
